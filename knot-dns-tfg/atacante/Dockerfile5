FROM debian:bullseye

RUN apt update && apt install -y \
    python3 \
    python3-pip \
    dnsutils \
    iputils-ping \
    curl \
    netcat \
    git \
    knot-dnsutils \
    tcpdump \
    openssl \
    socat \
    && pip3 install scapy

COPY poison.py /work/poison.py
COPY poison-doh.py /work/poison-doh.py
COPY tunneling.py /work/tunneling.py
COPY tunneling-dot.py /work/tunneling-dot.py
COPY tunneling-doh.py /work/tunneling-doh.py
WORKDIR /work

CMD [ "bash" ]
